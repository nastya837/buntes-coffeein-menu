# ==== Telegram ====
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...ваш_токен

# ==== LLM (Claude или OpenAI) ====
# Какой провайдер использовать: anthropic (Claude) или openai
LLM_PROVIDER=anthropic

# Ключ Anthropic (если LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Модель Claude. Мощная по умолчанию; для экономии можно поставить
# claude-haiku-4-5 или claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-4-8

# Ключ OpenAI (если LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ==== Настройки бота ====
# Валюта по умолчанию
DEFAULT_CURRENCY=EUR
# Часовой пояс по умолчанию (для отчётов и напоминаний)
DEFAULT_TIMEZONE=Europe/Berlin
# Во сколько (час, локальное время пользователя) присылать ежедневный отчёт
DAILY_REPORT_HOUR=20
# Путь к файлу базы данных
DATABASE_PATH=data/finance.db
